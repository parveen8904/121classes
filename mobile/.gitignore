# Capacitor / Node
node_modules/
www/.DS_Store

# Native projects are generated on your Mac with `npx cap add ios/android`.
# They're large and machine-specific, so we don't commit them here.
#
# EXCEPT the few files we hand-edit. A bare "android/" also swallowed the
# plugin's own Kotlin under mobile/plugins/, and any native fix we make is
# thrown away the next time the platform folder is regenerated. Whatever we
# have written by hand has to be tracked, or it is not really a fix.
# The same applies to iOS, and it was not doing so. Four files here are
# hand-edited: the push entitlement, the token forwarding in AppDelegate, the
# encryption declaration and deployment target in the project. All four were
# untracked while being written tonight — a fresh clone would have built an app
# that silently receives no notifications and asks the export question again.
ios/*
!ios/App/
ios/App/*
!ios/App/App/
ios/App/App/*
# ITSAppUsesNonExemptEncryption, and the camera/mic usage strings whose absence
# terminates the process rather than failing politely.
!ios/App/App/Info.plist
# aps-environment. Without it the app cannot register for notifications at all.
!ios/App/App/App.entitlements
# Apple hands the device token to the app delegate and nowhere else.
!ios/App/App/AppDelegate.swift
!ios/App/App.xcodeproj/
ios/App/App.xcodeproj/*
# Deployment target, version, build number, and the entitlements path.
!ios/App/App.xcodeproj/project.pbxproj

android/*
!plugins/**/android/
# git cannot re-include a file inside an excluded DIRECTORY, so every level on
# the way down has to be re-opened one at a time.
!android/app/
android/app/*
# Hand-edited: the version, the signing config, and the permissions. Losing
# these to a regenerated folder means an unsigned build with the wrong version
# code and no notification permission — found the hard way, since both were
# untracked while being edited.
!android/app/build.gradle
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
!android/app/src/main/java/

# Build outputs. Gradle's build/ sits INSIDE the plugin folder we just
# un-ignored, so it needs saying again or 1.7 MB of .dex lands in the repo.
plugins/**/build/
dist/
*.ipa
*.apk
*.aab

# The Android upload key password. Never in git.
android/keystore.properties
